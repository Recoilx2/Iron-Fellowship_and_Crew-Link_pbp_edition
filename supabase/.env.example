############
# Example env file for one copy of the Supabase stack.
#
# Copy to .env.ironsworn / .env.starforged (one file per game system) and fill
# in every blank value, or generate a filled file with:
#   python3 bin/gen-env.py --copy ironsworn --port 8000
#
# These files hold secrets: they are git-ignored and must never be committed.
# Start a copy with:
#   ENV_FILE=.env.ironsworn docker compose -p ironsworn --env-file .env.ironsworn up -d
############

# Which env file the containers read (must match the --env-file flag above).
ENV_FILE=.env.ironsworn

############
# Secrets - fill in every blank value before starting the containers.
############

# Postgres
POSTGRES_PASSWORD=

# Legacy symmetric HS256 key (at least 32 characters; bin/gen-env.py makes one).
JWT_SECRET=
# Legacy API keys (HS256-signed JWTs minted with JWT_SECRET).
ANON_KEY=
SERVICE_ROLE_KEY=

# New opaque API keys (optional; leave blank for legacy API key mode).
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# JSON array of signing JWKs (optional, Auth only).
#JWT_KEYS=
# JWKS for token verification (optional, used by PostgREST/Realtime/Storage).
#JWT_JWKS=
# Pre-signed asymmetric API keys (optional; leave blank for legacy API key mode).
#ANON_KEY_ASYMMETRIC=
#SERVICE_ROLE_KEY_ASYMMETRIC=

# Encryption seed for Realtime (required at boot).
SECRET_KEY_BASE=
# Realtime AES-256-GCM key: exactly 32 characters (generate with bin/gen-env.py).
# The legacy AES-128-ECB key is deliberately unsupported: fresh stacks encrypt
# everything with GCM from the start.
REALTIME_DB_ENC_KEY_GCM=

# Access key pair for Storage's S3 protocol endpoint.
S3_PROTOCOL_ACCESS_KEY_ID=
S3_PROTOCOL_ACCESS_KEY_SECRET=

# Encryption key for the optional admin dashboard add-on (studio.docker-compose.yml).
# Unused unless you start the dashboard. At least 32 characters.
PG_META_CRYPTO_KEY=

############
# URLs - one copy listens on 8000 (Ironsworn), the other on 8001 (Starforged).
############

# Full external URL of this copy's gateway.
SUPABASE_PUBLIC_URL=http://localhost:8000
# Full external URL of this copy's Auth service, used for email links.
API_EXTERNAL_URL=http://localhost:8000/auth/v1


############
# Database - Postgres configuration
############

POSTGRES_HOST=db
POSTGRES_DB=postgres

# Postgres uses POSTGRES_PORT inside the container. It is NOT published on the
# host: reach the database with `docker compose exec db psql` (see README).
POSTGRES_PORT=5432


############
# Auth - magic-link sign-in over your own mail server
############

# Equivalent to "Site URL" and "Redirect URLs" platform options:
# the app URL players return to after clicking a magic link. Points at this
# copy's site container; add dev-server origins here to sign in from `npm run
# dev` (comma-separated, e.g. http://localhost:5173).
SITE_URL=http://localhost:8080
ADDITIONAL_REDIRECT_URLS=

JWT_EXPIRY=3600
DISABLE_SIGNUP=false

## Mailer paths and email auth
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify

ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false

# Your mail server, which delivers the magic links.
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=Iron Fellowship

## Phone auth (off unless you configure an SMS provider in the template)
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false

# Anonymous sign-in (used for guest access); keep off unless the app needs it.
ENABLE_ANONYMOUS_USERS=false


############
# Storage
############

# S3 bucket when using S3 backend, directory name when using 'file'
GLOBAL_S3_BUCKET=stub

# Used for S3 protocol endpoint configuration
REGION=stub

# Equivalent to project_ref for the S3 protocol endpoint
STORAGE_TENANT_ID=stub


############
# Functions - Edge Runtime for server functions
############

# NOTE: VERIFY_JWT applies to all functions
FUNCTIONS_VERIFY_JWT=false

# Total Functions container memory limit, shared by all workers.
# Lowered from the upstream 2g default: one copy should fit a small host.
FUNCTIONS_MEMORY_LIMIT=512m


############
# Notes - server-saved shared editing (Hocuspocus)
############

# Total note-server container memory limit. Small: a few dozen small notes
# use tens of megabytes (measured during review; see the ticket #20 PR).
HOCUSPOCUS_MEMORY_LIMIT=256m


############
# API - configuration for PostgREST
############

# Postgres schemas exposed via the REST API
PGRST_DB_SCHEMAS=public,graphql_public

# Max number of rows returned by a request
PGRST_DB_MAX_ROWS=1000

# Extra schemas added to the search_path of every request
PGRST_DB_EXTRA_SEARCH_PATH=public


############
# Live updates - explicit per-tenant limits for Realtime
############

TENANT_MAX_BYTES_PER_SECOND=100000
TENANT_MAX_CHANNELS_PER_CLIENT=100
TENANT_MAX_CONCURRENT_USERS=200
TENANT_MAX_EVENTS_PER_SECOND=100
TENANT_MAX_JOINS_PER_SECOND=100


############
# API gateway
############

# Host port this copy's gateway listens on. Use 8000 for one copy
# and 8001 for the other so both run side by side.
API_GW_HTTP_PORT=8000


############
# Site - the built site for this copy's game system
############

# Which game system this copy serves: ironsworn or starforged. Matches the
# copy name; bin/gen-env.py fills it in, and the image bakes in that
# system's branding and theme.
GAME_SYSTEM=
# Host port this copy's site listens on. Use 8080 for one copy
# and 8081 for the other so both run side by side.
SITE_HTTP_PORT=8080


############
# Admin dashboard add-on (studio.docker-compose.yml)
############

# Host port for the temporary dashboard. Use 3000 for one copy, 3001 for the other.
STUDIO_HTTP_PORT=3000
# Display name inside the dashboard; COMPOSE_PROJECT_NAME comes from -p automatically.
#COMPOSE_PROJECT_NAME=
