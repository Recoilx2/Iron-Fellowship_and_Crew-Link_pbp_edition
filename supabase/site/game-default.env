# Generic build-time branding for a site running an operator-supplied ruleset.
# VITE_GAME_SYSTEM comes from the GAME_SYSTEM build arg; the ruleset package
# mounted at runtime supplies this site's title, favicon and theme (see #218).
VITE_TITLE=Iron Fellowship
VITE_FAVICON_PATH=/theme/sunset.svg
VITE_OPENGRAPH_PATH=/assets/ironsworn/opengraph-default.png
