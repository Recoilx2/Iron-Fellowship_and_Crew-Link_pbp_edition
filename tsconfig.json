{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": false,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    // The gm-assistant edge function and its shared protocol module are
    // imported by src (the live tests and the browser client) and by Deno,
    // whose relative imports must carry the ".ts" extension. noEmit makes
    // that safe for the type-check.
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "baseUrl": "src",
    "ignoreDeprecations": "5.0"
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
