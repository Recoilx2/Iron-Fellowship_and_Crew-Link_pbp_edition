#!/usr/bin/env python3
"""prepare-commit-msg: on a ticket/<n>-* branch, add `Refs #<n>` to the message.

Never blocks (always exits 0). Never writes Closes or Fixes: only a merged PR closes a ticket.
Args: message file, source, sha.
"""
import re
import subprocess
import sys
from pathlib import Path


def main() -> None:
    path = Path(sys.argv[1])
    if len(sys.argv) > 2 and sys.argv[2] in ("merge", "squash"):
        return
    branch = subprocess.run(["git", "symbolic-ref", "--short", "-q", "HEAD"],
                            capture_output=True, text=True).stdout.strip()
    m = re.match(r"ticket/(\d+)-", branch)
    if not m:
        return
    n = m.group(1)
    lines = path.read_text().splitlines()
    # `git commit -v` puts the diff below a scissors line; only what's above it is the message.
    cut = next((i for i, l in enumerate(lines) if l.startswith("# -") and " >8 " in l), len(lines))
    lines, tail = lines[:cut], lines[cut:]
    content = [i for i, l in enumerate(lines) if l.strip() and not l.startswith("#")]
    if not content or re.search(rf"#{n}\b", "\n".join(lines[i] for i in content)):
        return
    last = content[-1] + 1
    rest = lines[last:]
    path.write_text("\n".join(lines[:last] + ["", f"Refs #{n}"] + ([""] if rest and rest[0].strip() else []) + rest + tail) + "\n")


if __name__ == "__main__":
    try:
        main()
    except Exception:
        pass
    sys.exit(0)
