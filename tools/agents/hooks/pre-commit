#!/usr/bin/env python3
"""pre-commit: refuse a commit that adds an obvious key or token.

Scans only the added lines of the staged diff for a few high-confidence key
shapes. Prints the file and the kind of key, never the value. A line with
`not-a-secret` is skipped (for test fixtures and docs).
"""
import re
import subprocess
import sys

SHAPES = {
    "GitHub token": r"gh[pousr]_[A-Za-z0-9]{36}",
    "GitHub fine-grained token": r"github_pat_[A-Za-z0-9_]{22,}",
    "Anthropic key": r"sk-ant-[A-Za-z0-9_-]{20,}",
    "OpenAI project key": r"sk-proj-[A-Za-z0-9_-]{20,}",
    "AWS access key": r"AKIA[0-9A-Z]{16}",
    "private key": r"-----BEGIN [A-Z ]*PRIVATE KEY-----",
}


def main() -> int:
    diff = subprocess.run(["git", "diff", "--cached", "-U0", "--no-color"],
                          capture_output=True, text=True, errors="replace").stdout
    path, hits = "?", []
    for line in diff.splitlines():
        if line.startswith("+++ "):
            path = line[4:].removeprefix("b/")
        elif line.startswith("+") and "not-a-secret" not in line:
            for kind, pat in SHAPES.items():
                if re.search(pat, line):
                    hits.append(f"  {path}: looks like a {kind}")
    if hits:
        print("pre-commit: refused: staged changes add what looks like a secret:\n" + "\n".join(hits)
              + "\nKeys belong in a secret store or the environment. Unstage it; if one was real, rotate it.",
              file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
